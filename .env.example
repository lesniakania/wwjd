HF_TOKEN=
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
HF_MODEL_PL=speakleash/Bielik-11B-v3.0-Instruct
HF_BASE_URL=https://router.huggingface.co/v1
HF_MAX_TOKENS=1200
HF_TIMEOUT_SECONDS=45
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_SITUATION_LENGTH=3000
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DATABASE_URL=postgresql://wwjd:secret@localhost:5434/wwjd
POSTGRES_PORT=5434

# Evaluation experiments (raw preserves the existing reranker behavior).
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATES=50
RERANKER_STRATEGY=raw
EVALUATION_DIAGNOSTICS=false
# Export SOURCE_COMMIT in the server environment when collecting benchmark diagnostics.
# Optional extra model call before retrieval; uses the same inference provider.
SITUATION_ANALYSIS=false
ANALYSIS_TIMEOUT_SECONDS=20
